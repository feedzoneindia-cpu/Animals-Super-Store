{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpe?g|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://Animals-super-store-wq4r.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/shop/:slug",
      "destination": "/listings/:slug",
      "permanent": true
    },
    {
      "source": "/listings",
      "destination": "/shop",
      "permanent": true
    }
  ]
}
